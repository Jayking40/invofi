# ── Supabase ─────────────────────────────────────────────────────────────────
# Project dashboard: https://supabase.com/dashboard/project/ukhxnrlcqmyncjoericr
NEXT_PUBLIC_SUPABASE_URL=https://ukhxnrlcqmyncjoericr.supabase.co

# Your Supabase API key — use whichever name your dashboard shows.
# Older dashboard: Settings → API → "anon / public" key
# Newer dashboard: Settings → API → "Publishable" key
# Both are the same key; the app accepts either variable name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-or-publishable-key>

# ── Stellar / Soroban ─────────────────────────────────────────────────────────
# Three-contract deployment on Stellar testnet (see README Live Demo):
#   registry   — invoices, admin, pause, rates
#   financing  — offers, accept/reject, currency registry
#   repayment  — repay, mark overdue, reclaim
# Deploy your own via the invofi-contracts "Deploy Contracts to Testnet"
# workflow and replace these IDs.
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=CD4PT7V5U6TMF44IGWXWDRHERCW6VB5OJM4AHTFCQK3X75WJIJP4IYOB
NEXT_PUBLIC_FINANCING_CONTRACT_ID=CCJUYGGMF664FZOLKQEZKAVL3CWCWAVQBE75GVJN5CH5C3ZY55YEEL4P
NEXT_PUBLIC_REPAYMENT_CONTRACT_ID=CASENBBH7KEHOGGBTYSVOM46I7GJ5EC5RF7YVCCDGKMN3EOXVW56X5XU

# Legacy single-contract mode: if the three variables above are unset, the app
# falls back to NEXT_PUBLIC_CONTRACT_ID (all calls route to that one contract).
# NEXT_PUBLIC_CONTRACT_ID=CDS3WO5K6GUBGCLMRUR4IQYLDT5SNDOMUMZFDXOMXYP6EELLTM5MMALH

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: USDC issuer on testnet
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
